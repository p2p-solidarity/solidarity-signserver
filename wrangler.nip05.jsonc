{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The NIP-05 directory (`name@creds.id`) as its own Worker. The creds.id
	// and solidarity.gg zones live in THIS account (the one that also hosts the
	// solidarity-app / landing Pages projects), not in the account that runs
	// the inbox / PassKit worker (`wrangler.jsonc`), and a Worker route can only
	// be attached from the zone's own account. Deploy with
	// `bun run deploy:nip05` (scripts/deploy-nip05.sh): it creates the D1 on
	// first run, fills `database_id` below, applies `drizzle/` and deploys.
	//
	// creds.id is the product domain (share links are `creds.id/@name`), so the
	// identifier is `name@creds.id` — the directory answers on the same host the
	// viewer lives on (Pages); these Worker routes take precedence for exactly
	// the directory paths and nothing else.
	"name": "solidarity-id",
	"main": "src/nip05-worker.ts",
	"account_id": "b9e60d05860dfe2eaf2db7f9930875c0",
	"compatibility_date": "2025-09-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Routes only — the directory must answer on the identifier's own domain.
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"routes": [
		{
			"pattern": "creds.id/.well-known/nostr.json*",
			"zone_name": "creds.id"
		},
		// The wildcard route starts at /id/; DELETE /id needs its own exact route.
		{
			"pattern": "creds.id/id",
			"zone_name": "creds.id"
		},
		{
			"pattern": "creds.id/id/*",
			"zone_name": "creds.id"
		},
		{
			"pattern": "creds.id/vault/root/*",
			"zone_name": "creds.id"
		},
		// App association files (src/routes/wellKnown) on every host the app
		// claims in app.json — creds.id plus the pre-switch solidarity.gg hosts,
		// whose zone is in this account too. Without these routes the Pages SPA
		// answers with index.html and iOS/Android verification fails.
		{
			"pattern": "creds.id/.well-known/apple-app-site-association*",
			"zone_name": "creds.id"
		},
		{
			"pattern": "creds.id/.well-known/assetlinks.json*",
			"zone_name": "creds.id"
		},
		{
			"pattern": "solidarity.gg/.well-known/apple-app-site-association*",
			"zone_name": "solidarity.gg"
		},
		{
			"pattern": "solidarity.gg/.well-known/assetlinks.json*",
			"zone_name": "solidarity.gg"
		},
		{
			"pattern": "app.solidarity.gg/.well-known/apple-app-site-association*",
			"zone_name": "solidarity.gg"
		},
		{
			"pattern": "app.solidarity.gg/.well-known/assetlinks.json*",
			"zone_name": "solidarity.gg"
		},
		// atproto OAuth client_id stays on solidarity.gg (the app's ATPROTO_CLIENT_ID).
		{
			"pattern": "solidarity.gg/oauth/client-metadata.json*",
			"zone_name": "solidarity.gg"
		}
	],
	"vars": {
		// SHA-256 fingerprints (AA:BB:…, comma-separated) of every certificate
		// that signs gg.solidarity.app: Play Console → App integrity → App signing
		// key certificate, plus the upload key certificate for builds installed
		// outside Play. Empty → /.well-known/assetlinks.json answers 404.
		"ANDROID_SHA256_CERT_FINGERPRINTS": ""
	},
	"d1_databases": [
		{
			// Binding name is what the shared repository code reads; the database
			// itself is the directory's own (only `nip05_*` tables are used —
			// `drizzle/0000_inbox.sql` also creates an inbox table here that this
			// worker never touches).
			"binding": "INBOX_DB",
			"database_name": "solidarity_id",
			"database_id": "08f6a10c-742f-41d2-8094-b91f7beed484",
			"migrations_dir": "drizzle"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "2201",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "REGISTER_RATE_LIMITER",
			"namespace_id": "2202",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}
}
