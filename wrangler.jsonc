{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "airmeishi-backend",
	"main": "src/index.ts",
	"account_id": "8ed27adf5fb9847bb469619634095076",
	"compatibility_date": "2025-09-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"routes": [
		{
			"pattern": "solidarity.gg/.well-known/nostr.json*",
			"zone_name": "solidarity.gg"
		},
		// The wildcard route starts at /id/; DELETE /id needs its own exact route.
		{
			"pattern": "solidarity.gg/id",
			"zone_name": "solidarity.gg"
		},
		{
			"pattern": "solidarity.gg/id/*",
			"zone_name": "solidarity.gg"
		}
	],
	"d1_databases": [
		{
			"binding": "INBOX_DB",
			"database_name": "airmeishi_inbox",
			"database_id": "16045bea-3347-472b-9652-f320cab7f9d2",
			"migrations_dir": "drizzle"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "REGISTER_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}
}
