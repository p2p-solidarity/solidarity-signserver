{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The creds.id ID backend: the NIP-05 directory (`name@creds.id`) and the
	// passkey root vault. It lives in the account that owns the creds.id and
	// solidarity.gg zones (the one that also hosts the solidarity-app / landing
	// Pages projects), because a Worker route can only be attached from the
	// zone's own account. Deploy with `bun run deploy` (scripts/deploy.sh): it
	// creates the D1 on first run, fills `database_id` below, applies
	// `drizzle/` and deploys.
	//
	// creds.id is the product domain (share links are `creds.id/@name`), so the
	// identifier is `name@creds.id` — the directory answers on the same host the
	// viewer lives on (Pages); these Worker routes take precedence for exactly
	// the directory paths and nothing else.
	"name": "solidarity-id",
	"main": "src/index.ts",
	"account_id": "b9e60d05860dfe2eaf2db7f9930875c0",
	"compatibility_date": "2025-09-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Routes only — the directory must answer on the identifier's own domain.
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"routes": [
		{
			"pattern": "creds.id/.well-known/nostr.json*",
			"zone_name": "creds.id"
		},
		// The wildcard route starts at /id/; DELETE /id needs its own exact route.
		{
			"pattern": "creds.id/id",
			"zone_name": "creds.id"
		},
		{
			"pattern": "creds.id/id/*",
			"zone_name": "creds.id"
		},
		{
			"pattern": "creds.id/vault/root/*",
			"zone_name": "creds.id"
		}
	],
	"d1_databases": [
		{
			// NIP-05 handles + audit and root vaults. `drizzle/0000_inbox.sql` is
			// kept only because migrations are append-only; `0003_drop_inbox.sql`
			// removes that table again.
			"binding": "ID_DB",
			"database_name": "solidarity_id",
			"database_id": "08f6a10c-742f-41d2-8094-b91f7beed484",
			"migrations_dir": "drizzle"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "2201",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "REGISTER_RATE_LIMITER",
			"namespace_id": "2202",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}
}
